{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/etc/doxos/logo.txt",
    "color": {
      "1": "white",
      "2": "white"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " 󰄾 ",
    "color": {
      "keys": "white",
      "title": "bold_white"
    }
  },
  "modules": [
    "title",
    {
      "type": "custom",
      "format": "those who dare",
      "outputColor": "white"
    },
    "separator",
    {
      "type": "os",
      "format": "DOXos GNU/Linux ({12})"
    },
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
